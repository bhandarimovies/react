# Rename this file to .env and fill in your own values.
# MongoDB Atlas connection string. Include a database name at the end.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.0n4ndar.mongodb.net/portfolio?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# Email credentials used by Nodemailer for contact form notifications.
# For Gmail, create an App Password in your Google account and paste it here.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
